# Copy to .env and fill in values (never commit .env)

# Super Admin (seeded on first boot if account missing)
SUPER_ADMIN_EMAIL=monish.reddy@invensis.net
SUPER_ADMIN_PASSWORD=

# Connect Engine — must be reachable on the same Docker network as alarm-engine
# Local/full stack: http://CIS-Deployment-connect-engine:9010
# If connectengine runs on host: http://host.docker.internal:7012
CONNECT_ENGINE_URL=http://CIS-Deployment-connect-engine:9010

# Auth
# HUB_AUTH_DEV_EXPOSE_OTP must stay false in any real deployment — it makes
# MFA codes visible in the API response and on-screen instead of emailed.
HUB_AUTH_DEV_EXPOSE_OTP=false
# HUB_AUTH_ENFORCED must stay true — with it false, every API endpoint that
# doesn't do its own explicit role check (most of them) is reachable with NO
# authentication at all, token or not. Only turn this off for isolated local
# debugging, never anywhere reachable by anyone else.
HUB_AUTH_ENFORCED=true

# REQUIRED for production — a real, random secret. If unset, alarm-engine
# falls back to a hardcoded placeholder that's visible in this repo's source,
# which lets anyone forge login sessions. Generate one, e.g.:
#   openssl rand -base64 48
HUB_AUTH_JWT_SECRET=

# Comma-separated origins allowed to call /api/** directly from a browser
# (not needed for the Hub/PWA themselves — they proxy same-origin via nginx).
HUB_CORS_ALLOWED_ORIGINS=http://localhost:7040,http://localhost:5174

# Infra credentials (MongoDB/RabbitMQ/Postgres). These containers only listen
# on the private docker network + a handful of host ports meant for local
# dev access, but the values below are still real passwords checked into
# this repo's defaults — change them for anything beyond local/demo use.
# NOTE: MongoDB/RabbitMQ set their root password from these on first boot
# only (baked into the container's data volume) — if you change them after
# the stack has already started once, wipe the corresponding volume too, or
# the new password won't match what's actually stored.
# The *_URLENC variants are the SAME password, percent-encoded, for the few
# places it has to be embedded in a connection URI (mongodb://, amqp://) —
# Compose can't encode this for you, so if you change a password, update
# both variables for it. Defaults need no encoding change: %40 is `@`.
INFRA_MONGO_USER=monish
INFRA_MONGO_PASSWORD=admin@123
INFRA_MONGO_PASSWORD_URLENC=admin%40123
INFRA_RABBITMQ_USER=ICUcharting
INFRA_RABBITMQ_PASSWORD=admin@123
INFRA_RABBITMQ_PASSWORD_URLENC=admin%40123
INFRA_POSTGRES_PASSWORD=hub@123

# Web Push (browser notifications) identity keypair for notification-service.
# The defaults are a real keypair generated for this dev/demo instance, not
# placeholders — generate your own before any real deployment:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BLKYwR9R10uXjN-4niWs483ccOlJFLSC0SahNIN7NZy_BTRuQ07UiT_ENTUV-mtjHGSWhutwD6bMu2jRBC-VFA4
VAPID_PRIVATE_KEY=567k1VQcCBf9V-xSND_osaQdf0MKKQy6mfSIChFMLEg
VAPID_EMAIL=mailto:poc@Sentra ICU.health

# Docker network/IPs (change if server has overlapping subnet, e.g. CNS uses 172.25.0.0/16)
DOCKER_COMPOSE_SUBNET=172.31.0.0/16
DOCKER_COMPOSE_IP_ALARM_ENGINE=172.31.0.10
DOCKER_COMPOSE_IP_NOTIFICATION_SERVICE=172.31.0.11
DOCKER_COMPOSE_IP_ICU_WATCH_PWA=172.31.0.12
DOCKER_COMPOSE_IP_RABBITMQ_SETUP=172.31.0.13
DOCKER_COMPOSE_IP_NGROK=172.31.0.14
DOCKER_COMPOSE_IP_ICU_CONNECT_HUB=172.31.0.15
HUB_UI_PORT=8000
DOCKER_COMPOSE_IP_DEVICE_INGESTION=172.31.0.16
DEVICE_INGESTION_HTTP_PORT=7050
DEVICE_INGESTION_HL7_PORT=7061
# Host port for JSON-speaking devices (Philips IntelliVue, Draeger Evita
# V600, etc.) — a separate protocol/port from HL7, not a replacement.
DEVICE_INGESTION_JSON_PORT=7062
DOCKER_COMPOSE_IP_MONGODB=172.31.0.20
DOCKER_COMPOSE_IP_RABBITMQ=172.31.0.21
DOCKER_COMPOSE_IP_POSTGRES=172.31.0.22
POC_NETWORK_SUBNET=172.31.0.0/16

# SMTP — check your domain MX records first!
# Google Workspace (e.g. invensis.net): smtp.gmail.com + Google App Password
# Zoho Mail free/standard: smtp.zoho.in or smtp.zoho.com + Zoho App Password
# Zoho Mail paid/org: smtppro.zoho.in or smtppro.zoho.com + Zoho App Password
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
SMTP_PASSWORD=
AUTH_MAIL_FROM=your-email@yourdomain.com
