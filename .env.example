# Copy to .env and fill in values (never commit .env)

# Super Admin (seeded on first boot if account missing)
SUPER_ADMIN_EMAIL=monish.reddy@invensis.net
SUPER_ADMIN_PASSWORD=

# Connect Engine — must be reachable on the same Docker network as alarm-engine
# Local/full stack: http://CIS-Deployment-connect-engine:9010
# If connectengine runs on host: http://host.docker.internal:7012
CONNECT_ENGINE_URL=http://CIS-Deployment-connect-engine:9010

# Auth
HUB_AUTH_DEV_EXPOSE_OTP=false
HUB_AUTH_ENFORCED=false

# Docker network/IPs (change if server has overlapping subnet, e.g. CNS uses 172.25.0.0/16)
DOCKER_COMPOSE_SUBNET=172.31.0.0/16
DOCKER_COMPOSE_IP_ALARM_ENGINE=172.31.0.10
DOCKER_COMPOSE_IP_NOTIFICATION_SERVICE=172.31.0.11
DOCKER_COMPOSE_IP_ICU_WATCH_PWA=172.31.0.12
DOCKER_COMPOSE_IP_RABBITMQ_SETUP=172.31.0.13
DOCKER_COMPOSE_IP_NGROK=172.31.0.14
DOCKER_COMPOSE_IP_ICU_CONNECT_HUB=172.31.0.15
HUB_UI_PORT=8000
DOCKER_COMPOSE_IP_DEVICE_INGESTION=172.31.0.16
DEVICE_INGESTION_HTTP_PORT=7050
DEVICE_INGESTION_HL7_PORT=7061
DOCKER_COMPOSE_IP_MONGODB=172.31.0.20
DOCKER_COMPOSE_IP_RABBITMQ=172.31.0.21
DOCKER_COMPOSE_IP_POSTGRES=172.31.0.22
POC_NETWORK_SUBNET=172.31.0.0/16

# SMTP — check your domain MX records first!
# Google Workspace (e.g. invensis.net): smtp.gmail.com + Google App Password
# Zoho Mail free/standard: smtp.zoho.in or smtp.zoho.com + Zoho App Password
# Zoho Mail paid/org: smtppro.zoho.in or smtppro.zoho.com + Zoho App Password
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
SMTP_PASSWORD=
AUTH_MAIL_FROM=your-email@yourdomain.com
