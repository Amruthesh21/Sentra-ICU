# Hospital-site gateway only. Copy to .env.hospital and fill in.
# Never commit the filled file. Must match the cloud .env for JWT + queue name.

# Same secret as cloud alarm-engine (HUB_AUTH_JWT_SECRET). The Hub proxies
# Connect-a-device calls with the user's login token; this service verifies it.
HUB_AUTH_JWT_SECRET=

# Cloud RabbitMQ, reached over VPN / private link — not the public internet.
# Use amqps:// in production. URL-encode reserved characters in the password
# (@ becomes %40). Example for a laptop split-test against local infra:
#   amqp://ICUcharting:admin%40123@host.docker.internal:7003/ICUcharting
HOSPITAL_RABBITMQ_URL=

DEVICE_DATA_QUEUE=alarm-engine.device.data.queue

# Host ports the bedside devices (and optional cloud HTTP proxy) use.
DEVICE_INGESTION_HL7_PORT=7061
DEVICE_INGESTION_JSON_PORT=7062
DEVICE_INGESTION_HTTP_PORT=9050
# Bind HTTP to a VPN address in production, e.g. 10.8.0.2 — not a public NIC.
DEVICE_INGESTION_HTTP_BIND=0.0.0.0
